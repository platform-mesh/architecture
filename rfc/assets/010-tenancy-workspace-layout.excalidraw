      "fontFamily": 1,
      "text": "root:tenants:<org-uuid>              type: organization\n\nBINDS   tenancy               (no claims \u2192 defaultAPIBindings)\n             + tenancy-provisioner  (creates child workspaces)\n\nOBJECTS:   Membership   (scope=org  +  scope=workspace)\n\nno tenant RBAC here  \u2192  tenants cannot reach it",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "orgws",
      "originalText": "root:tenants:<org-uuid>              type: organization\n\nBINDS   tenancy               (no claims \u2192 defaultAPIBindings)\n             + tenancy-provisioner  (creates child workspaces)\n\nOBJECTS:   Membership   (scope=org  +  scope=workspace)\n\nno tenant RBAC here  \u2192  tenants cannot reach it",
      "lineHeight": 1.25,
      "autoResize": true
